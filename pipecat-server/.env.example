# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5000
# Public host of this server (set to your GCP VM IP:PORT so TeXML URLs resolve)
SERVER_HOST=34.180.6.84:5000
# Public HTTPS domain — nginx terminates TLS and proxies to PORT
SERVER_DOMAIN=34-180-6-84.nip.io

# ── Telnyx ─────────────────────────────────────────────────────────────────────
# Get from: Telnyx Portal → API Keys
TELNYX_API_KEY=

# Get from: Telnyx Portal → Voice → Programmable Voice → TeXML Applications → Create App
#   Application name: cortex_pipecat
#   Webhook URL: https://34-180-6-84.nip.io/telnyx-webhook
#   Voice Method: GET
# After saving, copy the Application ID into TELNYX_CC_APP_ID (server.py reads this name).
TELNYX_CC_APP_ID=

# Your Telnyx DID in E.164 format
TELNYX_PHONE_NUMBER=+14355009976

# ── Deepgram ────────────────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=hi

# ── OpenAI ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── ElevenLabs ──────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
# Sana (Hindi female voice)
ELEVENLABS_VOICE_ID=Ukfq9vQ0QNLZ4MGK0Uxc
ELEVENLABS_MODEL=eleven_turbo_v2_5

# ── Backend ─────────────────────────────────────────────────────────────────────
BACKEND_URL=https://cortex-backend-api.vercel.app
VOICE_SECRET=
CRON_SECRET=

# ── Call behaviour ───────────────────────────────────────────────────────────────
MAX_CALL_DURATION_S=300
# Hang up after this many seconds of silence (no user speech)
SILENCE_HANGUP_S=20
