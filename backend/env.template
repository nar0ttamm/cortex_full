# ============================================================
# Backend API — Environment Variables
# Copy to .env for local development
# Set all in Vercel dashboard for production
# ============================================================

# ── Database ──────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection String (Session mode)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ── Encryption ────────────────────────────────────────────
# AES-256 key for stored credentials (64-character hex)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Server ────────────────────────────────────────────────
PORT=4000

# ── Calling ───────────────────────────────────────────────
# simulated = do not place a live carrier call
# live = the voice service may dial. The queue worker still requires CALL_QUEUE_ENABLED=true.
CALLING_MODE=simulated

# Delay between lead ingest and first AI call (seconds)
CALL_DELAY_SECONDS=120

# Public URL of this backend (used in Exotel callback URLs)
# Set to your Vercel deployment URL in production
BACKEND_URL=http://localhost:4000

# Optional global MSG91 account. Tenants do not get their own keys.
# Auth key stays server-side. Never put it in the CRM project.
MSG91_AUTH_KEY=
MSG91_EMAIL_DOMAIN=
MSG91_EMAIL_FROM=
MSG91_EMAIL_FROM_NAME=CortexFlow
MSG91_EMAIL_REPLY_TO=
# JSON map of logical template key -> MSG91 email template_id
# {"lead_admin":"...","lead_thanks":"...","appt_booked_admin":"...","appt_booked_lead":"..."}
MSG91_EMAIL_TEMPLATES=
MSG91_WHATSAPP_INTEGRATED_NUMBER=
MSG91_WHATSAPP_LANGUAGE=en
# JSON map of logical key -> approved WhatsApp template name
# {"admin_new_lead":"...","lead_welcome":"...","appt_booked_admin":"...","appt_booked_lead":"...","callback_admin":"...","callback_lead":"...","appointment_reminder":"...","demo_welcome":"..."}
MSG91_WHATSAPP_TEMPLATES=
# Custom header x-msg91-webhook-secret configured in the MSG91 dashboard
MSG91_WEBHOOK_SECRET=
# Shared secret for POST /v1/email/inbound
INBOUND_WEBHOOK_SECRET=

# Automatic queue dialing stays off until an operator sets this to true.
CALL_QUEUE_ENABLED=false
# Public landing-page calls stay off until an operator sets this to true.
DEMO_CALLS_ENABLED=false
# Leave unset. The API trusts public CAs plus backend/certs/prod-ca-2021.crt
# (Supabase Root 2021 CA, https://supabase-downloads.s3.amazonaws.com/prod/ssl/prod-ca-2021.crt).

# ── Notifications ─────────────────────────────────────────
# Optional platform fallback when a tenant has no contact in settings.
ADMIN_EMAIL=
ADMIN_PHONE=

# ── Demo tenant ───────────────────────────────────────────
# Required only if DEMO_CALLS_ENABLED=true. No default is baked into the code.
DEFAULT_TENANT_ID=

# ── Security ──────────────────────────────────────────────
# Protects /v1/admin/* routes — required in production
ADMIN_TOKEN=

# Vercel Cron Secret — required in production. Also set on the Pipecat VM so it can poll the queue.
CRON_SECRET=

# ── Pipecat voice (GCP VM) ────────────────────────────────
VOICE_SERVICE_URL=
# Same value on cortex_voice VM (.env). Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VOICE_SECRET=
# When LLM returns naive ISO without offset, backend assumes IST (+05:30). Clock skew / webhook retries (ms).
APPOINTMENT_ISO_PAST_GRACE_MS=120000

# ── OAuth and lead sources ────────────────────────────────
# Set these on the Vercel project cortex-backend-api. Do not commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://cortex-backend-api.vercel.app/v1/google-calendar/callback
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
BACKEND_URL=https://cortex-backend-api.vercel.app
CRM_URL=https://crm.cortexflow.in
